# Copia este archivo a .env.local y completa los valores (nunca subas .env.local al repo).
# En Vercel estas variables las inyecta la integración con Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-o-publishable-key>

# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
